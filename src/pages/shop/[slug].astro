---
import type { GetStaticPaths } from 'astro';
import type { Product } from '../../lib/types';
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ProductImage from '../../components/ProductImage.astro';
import ProductTrack from '../../components/ProductTrack.astro';
import Lace from '../../components/Lace.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import { formatPrice, getCategory } from '../../lib/catalog';
import { getProducts } from '../../lib/content';
import { site } from '../../data/site';

export const getStaticPaths = (async () => {
  const products = await getProducts();
  return products.map((product) => ({ params: { slug: product.slug }, props: { product, products } }));
}) satisfies GetStaticPaths;

interface Props {
  product: Product;
  products: Product[];
}

const { product, products } = Astro.props;
const category = getCategory(product.category);
const depopUrl = product.depopUrl ?? site.depop.url;
const decoration = product.category === 'clothing' || product.category === 'hair' ? 'bow' : 'heart';

// Same category first, then the newest of the rest.
const related = [
  ...products.filter((p) => p.slug !== product.slug && p.category === product.category && !p.soldOut),
  ...products.filter((p) => p.slug !== product.slug && p.category !== product.category && !p.soldOut),
].slice(0, 8);

const thumbTints = ['blush', 'cream', 'petal', 'butter'] as const;
---

<Layout
  title={product.name}
  description={product.description ?? `${product.name} · ${product.kind}. Handmade by Sakura in Amsterdam.`}
  image={product.images[0]?.url}
  footerLace="var(--cream)"
>
  <div class="container crumbs">
    <Breadcrumb
      items={[
        { label: 'Home', href: '/' },
        { label: 'Shop', href: '/shop/' },
        { label: category.label, href: `/shop/?category=${category.id}` },
        { label: product.name },
      ]}
    />
  </div>

  <section class="container product" data-gallery>
    <div class="gallery">
      <div class="main-photo">
        <ProductImage
          class="arch"
          image={product.images[0]}
          placeholder={product.placeholder}
          tint={product.tint}
          scale={2}
          loading="eager"
        >
          {
            !product.images[0] && (
              <>
                <img class="sparkle s1" src="/images/icons/sparkle-a.svg" alt="" width="30" height="30" />
                <img class="sparkle s2" src="/images/icons/sparkle-b.svg" alt="" width="22" height="22" />
                <img class="sparkle s3" src="/images/icons/sparkle-c.svg" alt="" width="34" height="34" />
                <img class="sparkle s4" src="/images/icons/sparkle-d.svg" alt="" width="20" height="20" />
              </>
            )
          }
        </ProductImage>
        {
          decoration === 'heart' ? (
            <img class="decoration" src="/images/icons/title-heart.svg" alt="" width="70" height="70" />
          ) : (
            <img class="decoration" src="/images/icons/title-bow.svg" alt="" width="100" height="69" />
          )
        }
      </div>

      {
        product.images.length > 1 && (
          <ul class="thumbs">
            {product.images.slice(0, 4).map((image, i) => (
              <li>
                <button
                  class="thumb"
                  type="button"
                  aria-pressed={i === 0 ? 'true' : 'false'}
                  data-thumb={image.url}
                  data-alt={image.alt}
                  style={{ '--tint': `var(--${thumbTints[i] === 'butter' ? 'butter-l' : thumbTints[i]})` }}
                >
                  <img src={image.url} alt={`Show photo ${i + 1}`} loading="lazy" />
                </button>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <div class="info">
      <div class="pills">
        {product.soldOut ? <span class="pill pill--dark">Sold out</span> : product.isNew && <span class="pill">New</span>}
        <span class="pill pill--blush">{product.kind.split(' · ')[0]}</span>
      </div>
      <h1 class="name">{product.name}</h1>
      {product.subtitle && <p class="subtitle">{product.subtitle}</p>}
      <p class="price">
        <span class="amount">{formatPrice(product.price)}</span>
        <span class="shipping">excl. shipping</span>
      </p>
      {
        product.availability && (
          <p class="availability">
            <img src="/images/icons/heart.svg" alt="" width="14" height="14" />
            {product.availability}
          </p>
        )
      }
      {product.description && <p class="description">{product.description}</p>}

      {
        product.options.map((option, n) => (
          <fieldset class="option">
            <legend>{option.label}</legend>
            <div class="option-values">
              {option.values.map((value, i) => (
                <label>
                  <input class="visually-hidden" type="radio" name={`option-${n}`} value={value} checked={i === 0} />
                  <span class:list={['chip', { round: value.length <= 2 }]}>{value}</span>
                </label>
              ))}
            </div>
            {option.note && <p class="option-note">{option.note}</p>}
          </fieldset>
        ))
      }

      <div class="buy-box">
        <p class="script buy-title">{product.soldOut ? 'This one is gone' : 'Buy this treasure'}</p>
        {
          product.soldOut ? (
            <p class="sold-out-text">This treasure has found a new home. Want one like it? Make a wish and I'll make it for you.</p>
          ) : (
            <>
              {product.stripeUrl && (
                <a class="btn btn--primary btn--block" href={product.stripeUrl}>
                  Buy now
                </a>
              )}
              <a
                class:list={['btn btn--block', { 'btn--primary': !product.stripeUrl }]}
                href={depopUrl}
                target="_blank"
                rel="noopener"
              >
                Buy on Depop <span class="arrow" aria-hidden="true">↗</span>
              </a>
            </>
          )
        }
        <a class="wish-link" href="/custom-orders/#wish-form">Want another colour or size? Make a wish →</a>
      </div>

      <div class="accordion">
        <details open>
          <summary>Details &amp; materials</summary>
          <ul class="hearts">
            {product.details.map((detail) => <li>{detail}</li>)}
          </ul>
        </details>
        <details>
          <summary>Shipping &amp; returns</summary>
          <p>
            Orders ship from the Netherlands. Shipping costs and delivery times are shown at checkout. Returns follow
            Depop's rules. <a href="/terms/#shipping">Read more</a>
          </p>
        </details>
        <details>
          <summary>Care tips</summary>
          <p>Keep your treasure away from water and strong sunlight, and store it somewhere soft so it stays pretty.</p>
        </details>
      </div>

      <ul class="tags">
        <li class="tag"><img src="/images/icons/heart.svg" alt="" width="12" height="12" />Handmade in Amsterdam</li>
        <li class="tag"><img src="/images/icons/heart.svg" alt="" width="12" height="12" />Ships from NL</li>
        <li class="tag"><img src="/images/icons/heart.svg" alt="" width="12" height="12" />Gift-ready packaging</li>
      </ul>
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="related" data-carousel aria-labelledby="related-title">
        <Lace scallop="var(--white)" dot="var(--cream)" />
        <div class="container related-head">
          <SectionTitle id="related-title" script="More treats" title="You might also like" align="left" />
          <div class="arrows">
            <button class="icon-btn" type="button" data-prev>
              <img src="/images/icons/chevron-left.svg" alt="Previous products" width="20" height="20" />
            </button>
            <button class="icon-btn" type="button" data-next>
              <img src="/images/icons/chevron-right.svg" alt="Next products" width="20" height="20" />
            </button>
          </div>
        </div>
        <ProductTrack products={related} label="You might also like" />
      </section>
    )
  }
</Layout>

<script>
  // Switch the main photo when a thumbnail is clicked.
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const main = root.querySelector<HTMLImageElement>('.main-photo img.pi-photo');
    const thumbs = [...root.querySelectorAll<HTMLButtonElement>('[data-thumb]')];
    thumbs.forEach((thumb) =>
      thumb.addEventListener('click', () => {
        if (!main) return;
        main.src = thumb.dataset.thumb!;
        main.alt = thumb.dataset.alt ?? '';
        thumbs.forEach((t) => t.setAttribute('aria-pressed', String(t === thumb)));
      }),
    );
  });
</script>

<style>
  .crumbs {
    max-width: calc(1248px + 2 * var(--gutter));
    padding-top: 14px;
    padding-bottom: 8px;
  }

  .product {
    display: flex;
    align-items: flex-start;
    gap: 64px;
    max-width: calc(1248px + 2 * var(--gutter));
    padding-top: 24px;
    padding-bottom: 72px;
  }

  .gallery {
    display: flex;
    flex-direction: column;
    gap: 14px;
    flex: 0 1 640px;
    min-width: 0;
  }

  .main-photo {
    position: relative;
    padding-top: 30px;
  }

  .main-photo :global(.arch) {
    aspect-ratio: 640 / 560;
    border: 2px solid var(--pink);
    border-radius: 280px 280px 32px 32px;
  }

  .decoration {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
  }

  .sparkle {
    position: absolute;
    pointer-events: none;
  }

  .s1 {
    left: 17%;
    top: 26%;
  }

  .s2 {
    right: 19%;
    top: 30%;
  }

  .s3 {
    right: 14%;
    top: 76%;
  }

  .s4 {
    left: 14%;
    top: 75%;
  }

  .thumbs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .thumb {
    display: block;
    width: 100%;
    height: 120px;
    padding: 0;
    overflow: hidden;
    border: 1.5px solid var(--pink);
    border-radius: 16px;
    background: var(--tint);
    cursor: pointer;
  }

  .thumb[aria-pressed='true'] {
    border: 2.5px solid var(--pink-d);
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .info {
    flex: 1 0 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    min-width: 0;
  }

  .pills {
    display: flex;
    gap: 8px;
  }

  .name {
    font-weight: 700;
    font-size: 44px;
    line-height: 1.15;
  }

  .subtitle {
    font-weight: 500;
    font-size: 18px;
    color: var(--soft);
  }

  .price {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .amount {
    font-weight: 700;
    font-size: 30px;
  }

  .shipping {
    font-size: 14px;
    color: var(--soft);
  }

  .availability {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 500;
    font-size: 15px;
  }

  .description {
    font-size: 17px;
    line-height: 1.7;
  }

  .option {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .option legend {
    float: left;
    padding: 0;
    margin-bottom: 10px;
    font-weight: 700;
    font-size: 14px;
  }

  .option-values {
    clear: both;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chip.round {
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
  }

  .option-note {
    font-size: 13px;
    color: var(--soft);
  }

  .buy-box {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
    padding: 16px 24px 24px;
    border-radius: 28px;
    background: var(--blush);
  }

  .buy-title {
    font-size: 36px;
  }

  .sold-out-text {
    font-size: 15px;
    line-height: 1.6;
  }

  .wish-link {
    font-weight: 500;
    font-size: 14px;
    color: var(--rose);
    text-decoration: none;
  }

  .wish-link:hover {
    text-decoration: underline;
  }

  .accordion {
    width: 100%;
  }

  details {
    border-bottom: 1.5px solid var(--pink);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 0;
    font-weight: 700;
    font-size: 19px;
    list-style: none;
    cursor: pointer;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: '+';
    font-family: system-ui, sans-serif;
    font-weight: 400;
    font-size: 22px;
    color: var(--rose);
  }

  details[open] summary::after {
    content: '–';
  }

  details p {
    padding-bottom: 16px;
    font-size: 15px;
    line-height: 1.6;
  }

  .hearts {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
    padding: 0 0 16px;
    list-style: none;
    font-size: 15px;
  }

  .hearts li {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .hearts li::before {
    content: '';
    flex-shrink: 0;
    width: 12px;
    height: 12px;
    background: url('/images/icons/heart.svg') no-repeat center / contain;
  }

  .tags {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tags .tag {
    padding: 6px 14px 6px 10px;
  }

  .related {
    background: var(--cream);
    padding-bottom: 64px;
  }

  .related-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    padding-top: 44px;
    padding-bottom: 20px;
  }

  .arrows {
    display: flex;
    gap: 10px;
  }

  @media (max-width: 1000px) {
    .product {
      flex-direction: column;
      gap: 32px;
    }

    .gallery {
      flex-basis: auto;
      width: 100%;
      max-width: 640px;
      margin-inline: auto;
    }
  }

  @media (max-width: 640px) {
    .name {
      font-size: 32px;
    }

    .amount {
      font-size: 26px;
    }

    .description {
      font-size: 16px;
    }

    .thumb {
      height: 80px;
    }

    .main-photo :global(.pi-illustration) {
      width: 50%;
    }
  }
</style>
