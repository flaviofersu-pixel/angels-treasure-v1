---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found" noindex>
  <section class="not-found pattern-dots">
    <div class="container inner">
      <img src="/images/icons/heart-glossy.svg" alt="" width="70" height="70" />
      <h1>
        <span class="script big">Oh no!</span>
        <span class="title">This treasure can't be found</span>
      </h1>
      <p class="plate">The page may have moved, or the treasure has found a new home.</p>
      <div class="buttons">
        <a class="btn btn--primary btn--lg" href="/shop/">Go to the shop</a>
        <a class="btn btn--lg" href="/">Back home</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    padding-top: 72px;
    padding-bottom: 96px;
    text-align: center;
  }

  h1 {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0;
    font-weight: 400;
  }

  .big {
    font-size: 80px;
    line-height: 1.1;
  }

  .title {
    font-weight: 700;
    font-size: 36px;
    line-height: 1.2;
  }

  .plate {
    padding: 12px 18px;
    border-radius: 18px;
    background: var(--white);
    font-size: 17px;
  }

  .buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  @media (max-width: 640px) {
    .big {
      font-size: 60px;
    }

    .title {
      font-size: 26px;
    }
  }
</style>
