---
import Layout from '../layouts/Layout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import { site } from '../data/site';

const parts = [
  {
    id: 'buying',
    title: 'Buying via Depop',
    paragraphs: [
      'Everything that is ready to ship is sold through Depop. Payment, buyer protection and order messages all go through Depop.',
      `Questions about an order? Send a message on Depop or email ${site.email}.`,
    ],
  },
  {
    id: 'custom-orders',
    title: 'Custom orders',
    paragraphs: [
      'Every custom order starts with a talk about the design. Sakura works out which materials are needed and gives you an estimate of the total price.',
      'Material costs are paid up front, before Sakura starts. Because a custom piece is made just for you, it cannot be returned. [invullen]',
    ],
  },
  {
    id: 'shipping',
    title: 'Shipping',
    paragraphs: ['Orders ship from the Netherlands. Shipping costs and delivery times: [invullen].'],
  },
  {
    id: 'returns',
    title: 'Returns',
    paragraphs: ["Returns for ready-made items follow Depop's rules. [invullen]"],
  },
  {
    id: 'privacy',
    title: 'Privacy',
    paragraphs: [
      'Your name, email and the details of your wish are only used to make and send your order. They are never sold or shared with others.',
      'This website does not use tracking cookies.',
    ],
  },
  {
    id: 'contact',
    title: 'Contact',
    paragraphs: [
      `Email: ${site.email}`,
      `Instagram ${site.instagram.handle} · TikTok ${site.tiktok.handle}`,
      `KvK: ${site.kvk}`,
    ],
  },
];
---

<Layout title="Terms & privacy" description="How buying, custom orders, shipping, returns and privacy work at Angel's Treasure." footerLace="var(--white)">
  <section class="title pattern-gingham">
    <div class="container title-inner">
      <SectionTitle as="h1" script="The small print" title="Terms & privacy" icon="heart" plate size="lg" />
    </div>
  </section>

  <section class="terms">
    <div class="container layout">
      <nav class="card toc" aria-label="On this page">
        <h2>On this page</h2>
        <ul>
          {
            parts.map((part) => (
              <li>
                <a href={`#${part.id}`}>{part.title}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="text">
        <p class="updated">Last updated: [datum]</p>
        {
          parts.map((part, i) => (
            <section class="part" id={part.id} aria-labelledby={`${part.id}-title`}>
              <h2 id={`${part.id}-title`}>
                {i % 2 === 0 ? (
                  <img src="/images/icons/title-heart.svg" alt="" width="28" height="28" />
                ) : (
                  <img src="/images/icons/title-bow.svg" alt="" width="36" height="25" />
                )}
                {part.title}
              </h2>
              {part.paragraphs.map((p) => (
                <p>{p}</p>
              ))}
            </section>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  .title-inner {
    padding-top: 48px;
    padding-bottom: 56px;
  }

  .terms {
    background: var(--white);
  }

  .layout {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    align-items: start;
    gap: 56px;
    max-width: calc(1040px + 2 * var(--gutter));
    padding-top: 48px;
    padding-bottom: 80px;
  }

  .toc {
    position: sticky;
    top: 24px;
    padding: 22px 24px;
    border-radius: 24px;
  }

  .toc h2 {
    margin-bottom: 12px;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 1.56px;
    text-transform: uppercase;
    color: var(--rose);
  }

  .toc ul {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .toc a {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 500;
    font-size: 15px;
    text-decoration: none;
  }

  .toc a::before {
    content: '';
    width: 12px;
    height: 12px;
    background: url('/images/icons/heart.svg') no-repeat center / contain;
  }

  .toc a:hover {
    color: var(--rose);
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .updated {
    font-size: 14px;
    color: var(--soft);
  }

  .part {
    display: flex;
    flex-direction: column;
    gap: 12px;
    scroll-margin-top: 24px;
  }

  .part h2 {
    display: flex;
    align-items: center;
    gap: 12px;
    font-weight: 700;
    font-size: 26px;
  }

  .part p {
    font-size: 17px;
    line-height: 1.7;
  }

  @media (max-width: 860px) {
    .layout {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .toc {
      position: static;
    }
  }

  @media (max-width: 640px) {
    .part h2 {
      font-size: 22px;
    }

    .part p {
      font-size: 16px;
    }
  }
</style>
