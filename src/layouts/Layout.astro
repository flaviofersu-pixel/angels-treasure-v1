---
import '@fontsource/zen-maru-gothic/400.css';
import '@fontsource/zen-maru-gothic/500.css';
import '@fontsource/zen-maru-gothic/700.css';
import '@fontsource/pinyon-script/400.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  // Background colour of the last section, so the footer lace blends in.
  footerLace?: string;
  // Keep the page out of search results (e.g. thank-you page)
  noindex?: boolean;
}

const siteName = "Angel's Treasure";
const {
  title,
  description = 'Little treasures for your Jfashion coord. Handmade by Sakura in Amsterdam.',
  image = '/images/logo-large.png',
  footerLace,
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} · ${siteName}` : siteName;
const imageUrl = Astro.site ? new URL(image, Astro.site).href : image;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer laceColor={footerLace} />
  </body>
</html>
