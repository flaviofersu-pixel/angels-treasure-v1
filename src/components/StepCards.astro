---
// Numbered step cards ("1 Tell me your idea", ...).
interface Props {
  steps: { title: string; text: string }[];
  // Fixed card width in px, or 'fluid' to share the row
  cardWidth?: number | 'fluid';
}

const { steps, cardWidth = 'fluid' } = Astro.props;
const columns = cardWidth === 'fluid' ? `repeat(${steps.length}, 1fr)` : `repeat(${steps.length}, ${cardWidth}px)`;
---

<ol class="steps" style={{ '--columns': columns }}>
  {
    steps.map((step, i) => (
      <li class="card step">
        <span class="step-number">{i + 1}</span>
        <h3>{step.title}</h3>
        <p>{step.text}</p>
      </li>
    ))
  }
</ol>

<style>
  .steps {
    display: grid;
    grid-template-columns: var(--columns);
    justify-content: center;
    gap: 20px;
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
    text-align: left;
  }

  .step {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    padding: 20px 22px 22px;
  }

  h3 {
    font-weight: 700;
    font-size: 20px;
  }

  p {
    font-size: 14px;
    line-height: 1.55;
    color: var(--soft);
  }

  @media (max-width: 1000px) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .steps {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .step {
      display: grid;
      grid-template-columns: 36px 1fr;
      column-gap: 12px;
      row-gap: 2px;
      align-items: center;
      padding: 14px 16px;
      border-radius: 20px;
    }

    .step-number {
      grid-row: span 2;
    }

    h3 {
      font-size: 17px;
    }
  }
</style>
