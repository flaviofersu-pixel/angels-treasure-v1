---
// Round lace doily with the shop logo and a heart on top.
---

<div class="doily" aria-hidden="true">
  <img class="lace" src="/images/doily.svg" alt="" width="420" height="420" />
  <img class="logo" src="/images/logo-large.png" alt="" width="305" height="305" loading="lazy" />
  <img class="heart" src="/images/icons/heart-glossy.svg" alt="" width="67" height="67" />
</div>

<style>
  .doily {
    position: relative;
    flex-shrink: 0;
    width: 420px;
    height: 420px;
  }

  .lace {
    width: 100%;
    height: 100%;
  }

  .logo {
    position: absolute;
    top: 13.8%;
    left: 13.8%;
    width: 72.6%;
    height: 72.6%;
  }

  .heart {
    position: absolute;
    top: -8px;
    left: 42.1%;
    width: 16%;
    height: auto;
  }

  @media (max-width: 640px) {
    .doily {
      width: 230px;
      height: 230px;
    }
  }
</style>
